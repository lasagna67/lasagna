# пример переменных окружения.
# Для Docker Compose скопируйте в .env.docker.
# Для `make run` скопируйте в .env и укажите адреса сервисов с хоста:
# POSTGRES_HOST=localhost, REDIS_HOST=localhost,
# S3_ENDPOINT=http://localhost:9000, KAFKA_BROKERS=localhost:9092.
# Заполните значения, помеченные REQUIRED.
# Имена выводятся из internal/config (caarlos0/env): <PREFIX> + UPPER_SNAKE(имя поля),
# аббревиатуры не разбиваются — отсюда AUTH_SMS_RU_APIID.
# Поля без значения здесь имеют дефолт в коде — переопределяйте при необходимости.

# ---- Общее ----
# local | development | production
ENVIRONMENT=development
APP_NAME=server

# ---- Postgres (POSTGRES_) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres          # REQUIRED
POSTGRES_PASSWORD=postgres      # REQUIRED
POSTGRES_DB=postgres
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_CONN_MAX_LIFETIME=5m

# ---- HTTP-сервер (HTTP_) ----
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_SIZE=10M
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://studio.apollographql.com

# ---- Redis (REDIS_) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=server

# ---- S3 (S3_) ----
# MinIO из docker-compose; с хоста: http://localhost:9000
S3_ENDPOINT=http://minio:9000           # REQUIRED
# адрес для браузера: им подписываются presigned-ссылки; пусто — S3_ENDPOINT
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1                     # REQUIRED
S3_ACCESS_KEY_ID=minioadmin             # REQUIRED
S3_SECRET_ACCESS_KEY=minioadmin         # REQUIRED
# бакеты через запятую для проверки при старте (HeadBucket); пусто — ListBuckets
S3_BUCKETS=
S3_PING_TIMEOUT=15s
S3_UPLOAD_EXPIRES=15m
# бакет документов заявок (договоры); в docker-compose minio создаёт его сам
S3_DOCUMENTS_BUCKET=documents
# root-учётка контейнера minio, бекенд её не читает — держите равной ключам выше
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Kafka (KAFKA_) ----
# брокеры через запятую
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=lasagna

# ---- Конвейер проверок заявки (PIPELINE_) ----
# consumer group этапов validation → enrichment → scoring
PIPELINE_CONSUMER_GROUP=lasagna-pipeline
# партиции топиков при создании
PIPELINE_PARTITIONS=3
# опрос outbox: интервал и размер пачки
PIPELINE_OUTBOX_INTERVAL=500ms
PIPELINE_OUTBOX_BATCH=100
# пауза перед перезапуском consumer после сбоя
PIPELINE_RESTART_DELAY=5s

# ---- Аутентификация (AUTH_) ----
# время жизни сессии
AUTH_SESSION_TTL=24h

# ---- Моки внешних систем ----
# ЕГРЮЛ/ЕГРИП; с хоста: http://localhost:8081
REGISTRY_URL=http://registry-mock:8081
REGISTRY_TIMEOUT=5s
BKI_URL=http://bki-mock:8082
BKI_TIMEOUT=5s
FINANCIALS_URL=http://financials-mock:8083
FINANCIALS_TIMEOUT=5s
# КЭП; с хоста: http://localhost:8084
ESIGN_URL=http://esign-mock:8084
ESIGN_TIMEOUT=5s

# ---- Логирование (LOGGING_) ----
# уровень: debug | info | warn | error
LOGGING_LEVEL=info
# формат: json | console
LOGGING_ENCODING=json
