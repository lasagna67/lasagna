# Build stage
FROM golang:1.27.1-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrator ./cmd/migrator \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/demo-seed ./cmd/demo-seed \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/staff-seed ./cmd/staff-seed



# Runtime base
FROM alpine:3.24 AS runtime

RUN addgroup -S app && adduser -S -G app app

WORKDIR /app



# Migrator: docker build --target migrator
FROM runtime AS migrator

COPY --from=builder /out/migrator ./migrator
# cmd/migrator читает миграции из migration относительно рабочей директории
COPY migration/*.sql ./migration/

USER app:app

ENTRYPOINT ["/app/migrator"]
CMD ["up"]



# Demo users/companies through the API; settlement accounts through PostgreSQL.
FROM runtime AS demo-seed

RUN mkdir -p /data && chown app:app /data
COPY --from=builder /out/demo-seed ./demo-seed
USER app:app
ENTRYPOINT ["/app/demo-seed"]

# Staff account: one-shot, direct database access — public registration cannot grant a staff role.
FROM runtime AS staff-seed

COPY --from=builder /out/staff-seed ./staff-seed
USER app:app
ENTRYPOINT ["/app/staff-seed"]

# Server (стадия по умолчанию)
FROM runtime AS server

COPY --from=builder /out/server ./server

USER app:app

EXPOSE 8080

ENTRYPOINT ["/app/server"]
