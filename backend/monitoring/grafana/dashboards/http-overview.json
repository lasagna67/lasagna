      "targets": [{"editorMode": "code", "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.000001)", "legendFormat": "5xx", "range": true, "refId": "A"}],
      "title": "HTTP 5xx share",
